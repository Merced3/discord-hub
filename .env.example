# Copy to .env and fill in. Never commit .env.

# Source: Discord Developer Portal -> your application -> Bot -> Token
# (Reset Token to generate a new one; shown only once.)
DISCORD_TOKEN=your-bot-token-here
# Source: Discord client with Developer Mode on -> right-click your server
# -> Copy Server ID.
DISCORD_GUILD_ID=your-server-id-here
HUB_HOST=127.0.0.1
HUB_PORT=8100

# Directory for disposable status and the JSON backend's local development state.
DATA_DIR=data

# Optional: fully Courier-owned generated command reference. First enable purges
# legacy messages in this dedicated channel; later runs reconcile generated IDs only.
# HOW_TO_CHANNEL_ID=123456789012345678

# Production state (optional locally; JSON is the default when unset).
# DISCORD_HUB_DATABASE_URL=postgresql://...:25061/discord_hub?sslmode=require
# HARNESS_DATABASE_URL=postgresql://...:25061/harness_discord_hub?sslmode=require

# Not used by the code, but handy to have: it's in the bot's invite link
# if you ever re-invite Courier with new scopes.
DISCORD_APPLICATION_ID=your-application-id-here

# Cross-host project identity (ADR 0011). Disabled preserves local development
# compatibility. Use optional during migration, then required in production.
# Tokens are secrets: use independent random values and never log or commit them.
HUB_AUTH_MODE=disabled
# HUB_PROJECT_TOKENS={"socratic-partner":"random-secret","teaching-agent":"another-secret"}
# HUB_OPERATOR_TOKEN=separate-operator-secret
# Before required mode, assign existing state explicitly by exact callback URL:
# HUB_LEGACY_CALLBACK_PROJECTS={"http://localhost:9000/discord":"socratic-partner"}

# Reaction markers (optional): emoji -> marker name, as a JSON object.
# Registrations with "reaction_events": true get a callback whenever one of
# these emojis is added to / removed from any message in the server.
# REACTION_MARKERS={"🔄": "belief_change", "🔒": "private", "⭐": "key_decision"}

# Documented Self source archive (ADR 0012). Disabled with an empty ID list.
# Stable Discord channel/forum IDs only; threads inherit their parent.
# ARCHIVE_CHANNEL_IDS=[123456789012345678,234567890123456789]
# Explicit consumer read grants; no wildcard and no tokenless access.
# ARCHIVE_READER_CHANNELS={"socratic-partner":[123456789012345678]}
# Required when capture is enabled. Use the hub's existing R2 credentials.
# DISCORD_HUB_R2_ACCOUNT_ID=...
# DISCORD_HUB_R2_ACCESS_KEY_ID=...
# DISCORD_HUB_R2_SECRET_ACCESS_KEY=...
# DISCORD_HUB_R2_BUCKET=automations-discord-hub
# DISCORD_HUB_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
