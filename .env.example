# Copy to .env and fill in. Never commit .env.
DISCORD_TOKEN=your-bot-token-here
DISCORD_GUILD_ID=your-server-id-here
HUB_HOST=127.0.0.1
HUB_PORT=8100

# Thread deletion is disabled by default. Set a JSON list of parent channel IDs
# only after approving cleanup there, e.g. [123456789012345678]. Consumers must
# still ask you to confirm each deletion. Restart the hub after changing this.
THREAD_DELETION_ALLOWED_PARENT_IDS=[]

# Not used by the code, but handy to have: it's in the bot's invite link
# if you ever re-invite Courier with new scopes.
DISCORD_APPLICATION_ID=your-application-id-here
